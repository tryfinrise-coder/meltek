{
  "name": "meltek",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @meltek/engine && npm run build -w @meltek/schema && npm run build -w @meltek/web && npm run build -w @meltek/api",
    "test": "npm run test -w @meltek/engine",
    "dev": "npm run dev -w @meltek/api",
    "start": "node apps/api/dist/start.js",
    "seed": "node apps/api/dist/seed.js"
  },
  "dependencies": {
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/node": "^22.10.2",
    "@types/express": "^5.0.0",
    "@types/pg": "^8.11.10",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
